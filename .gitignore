node_modules/
dist/
*.tsbuildinfo
.vite/
coverage/
art/out/
art/__pycache__/
# NOT ignored: packages/client/public/models/
# The .glb files are Blender output, but the deployed site loads them at
# runtime and CI cannot run Blender. They are ~1.8MB across 84 files, so they
# are committed as the built artefact they are. art/ remains the source.
.tunnel-*.log
packages/tools/src/scratch*
# Review renders and generated artefacts. The scripts that make them are the
# source; the pictures are output and are regenerated on demand.
art/shots/
!art/reference/
artefacts/

# Screenshots of the running game. Artifacts of packages/tools/src/shots.ts.
shots/

# The blender-model skill's own documentation images. The skill itself is
# vendored — `art/lib.py` and `art/shots.py` *are* its toolkit, so its
# reference material belongs with the project — but three megabytes of example
# renders of a lighthouse and a sports car are not this game's art.
.claude/skills/*/images/
